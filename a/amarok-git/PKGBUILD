pkgname=amarok-git
pkgver=3.3.3.r41.g087b788
pkgrel=1
pkgdesc="The powerful music player for KDE"
arch=(x86_64)
url="https://apps.kde.org/amarok/"
license=(GPL-2.0-or-later)
depends=(
    ffmpeg
    fftw
    glib2
    glibc
    gst-plugins-base-libs
    gstreamer
    hicolor-icon-theme
    karchive
    kcmutils
    kcodecs
    kcolorscheme
    kcompletion
    kconfig
    kconfigwidgets
    kcoreaddons
    kcrash
    kdbusaddons
    kdnssd
    kglobalaccel
    kguiaddons
    ki18n
    kiconthemes
    kio
    kirigami
    #kirigami2
    kitemviews
    knotifications
    kpackage
    kstatusnotifieritem
    ktexteditor
    ktextwidgets
    kwidgetsaddons
    kwindowsystem
    kxmlgui
    libmariadbclient
    libstdc++
    mariadb
    qt6-base
    qt6-declarative
    qt6-svg
    qt6-tools
    qt6-webengine
    solid
    taglib
    threadweaver
    )
makedepends=(
    extra-cmake-modules
    gdk-pixbuf2
    git
    kdoctools
    knotifyconfig
    libmtp
    loudmouth
    vulkan-headers
    )
optdepends=(
    "liblastfm-qt6: Last.fm service"
    "libmtp: support for portable media devices"
    "loudmouth: backend needed by mp3tunes for syncing"
    )
conflicts=(amarok)
provides=(amarok)
source=("git+https://invent.kde.org/multimedia/amarok.git")
sha512sums=('SKIP')

pkgver() {
  cd "amarok"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  local _flags=(
    -DWITH_GPODDER=OFF
    -DWITH_IPOD=OFF
    -DBUILD_TESTING=OFF
  )

  cmake -B build -S "amarok" -Wno-dev \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    "${_flags[@]}"

  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
