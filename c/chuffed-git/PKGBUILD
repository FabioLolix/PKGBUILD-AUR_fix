# Maintainer: Fabio 'Lolix' Loli <fabio.loli@disroot.org> -> https://github.com/FabioLolix

pkgname=chuffed-git
pkgver=0.14.0.r0.gf698d56
pkgrel=1
pkgdesc="Lazy clause generation solver"
arch=(x86_64)
url="https://github.com/chuffed/chuffed"
license=(MIT)
depends=(
    glibc
    libgcc
    libstdc++
    )
makedepends=(
    cmake
    git
    )
provides=(chuffed)
conflicts=(chuffed)
source=("git+https://github.com/chuffed/chuffed.git")
sha256sums=('SKIP')

pkgver() {
  cd chuffed
  git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cmake -B build -S chuffed -Wno-author \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -D chuffed/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
