# Maintainer: Fabio 'Lolix' Loli <fabio.loli@disroot.org> -> https://github.com/FabioLolix

pkgname=chuffed
pkgver=0.14.0
pkgrel=1
pkgdesc="Lazy clause generation solver"
arch=(x86_64)
url="https://github.com/chuffed/chuffed"
license=(MIT)
depends=(
    glibc
    libgcc
    libstdc++
    )
makedepends=(
    cmake
    git
    )
source=("git+https://github.com/chuffed/chuffed.git#tag=${pkgver}")
sha256sums=('25e59353ee636211d1577cfdb05be9c8cf571934039e6120c15f8252a683a676')

build() {
  cmake -B build -S chuffed -Wno-author \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -D chuffed/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
