pkgname=luminancehdr-git
pkgver=2.6.0.r335.gc767afb
pkgrel=1
pkgdesc="Open source graphical user interface application that aims to provide a workflow for HDR imaging"
arch=(x86_64)
url="https://github.com/LuminanceHDR/LuminanceHDR"
license=(GPL-2.0-or-later)
depends=(
    exiv2
    fftw
    gsl
    lcms2
    libraw
    openexr
    qt6-webengine
    #qt6-svg
    #ccfits
    hicolor-icon-theme
    boost-libs
    cfitsio
    glibc
    libgcc
    libgomp
    libjpeg-turbo
    libpng
    libstdc++
    libtiff
    qt6-base
    )
makedepends=(
    git
    cmake
    boost
    eigen
    qt6-tools
    qt6-svg
    vulkan-headers
    )
optdepends=('hugin: align image stack functionality')
provides=(luminancehdr)
conflicts=(luminancehdr)
#options=('!emptydirs')
source=("git+https://github.com/LuminanceHDR/LuminanceHDR.git#branch=release/3.0.0")
b2sums=('SKIP')

pkgver() {
  cd LuminanceHDR
  git describe --long --tags --abbrev=7 | sed 's/^v.//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  # Disable warning Detected locale "C" with character encoding "ANSI_X3.4-1968", which is not UTF-8.
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8

  # Disable all warnings
  export CFLAGS+=" -w"
  export CXXFLAGS+=" -w"

  cmake -B build -S "LuminanceHDR" -Wno-author \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr

  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
