# Maintainer: Fabio 'Lolix' Loli <fabio.loli@disroot.org> -> https://github.com/FabioLolix

pkgname=unordered_dense_tests
pkgver=4.9.2
pkgrel=1
pkgdesc="A fast & densely stored hashmap and hashset based on robin-hood backward shift deletion"
arch=(any)
url="https://github.com/martinus/unordered_dense"
license=(MIT)
makedepends=(
    boost   # for tests
    doctest # for tests
    fmt     # for tests
    git
    meson
    ninja
    )
source=("git+https://github.com/martinus/unordered_dense.git#tag=v${pkgver}")
sha256sums=('3955d39d5c28fc30f67adf48a72fe14bec218c6691ee0580e51752f2ae7a6a94')

prepare() {
  cd unordered_dense/test/app
  sed -i 's|#include <doctest.h>|#include <doctest/doctest.h>|g' doctest.h
}

build() {
  arch-meson unordered_dense build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "${pkgdir}"

  install -Dm644 unordered_dense/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
